(module
  (func (export "joins") (param $n i32) (result i32)
    (local $i i32) (local $acc i32)
    (local.set $acc (i32.const 11))
    (loop $l
      (local.set $acc (i32.add
        (i32.xor (i32.mul (local.get $acc) (i32.const 5))
                 (i32.mul (local.get $i) (i32.const 7)))
        (if (result i32) (i32.and (local.get $i) (i32.const 1))
          (then (i32.sub (local.get $acc) (local.get $i)))
          (else (i32.shl (local.get $i) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $acc))

  (func (export "pressure") (param $a i64) (param $b i64) (param $c i64)
    (param $d i64) (result i64)
    (local $i i64) (local $acc i64)
    (local.set $acc (i64.const 1))
    (loop $l
      (local.set $acc (i64.xor
        (i64.add (i64.mul (local.get $acc) (local.get $a))
                 (i64.sub (i64.xor (local.get $b) (local.get $i))
                          (i64.shl (local.get $c)
                                   (i64.and (local.get $i) (i64.const 7)))))
        (i64.sub (i64.add (i64.rotr (local.get $d) (i64.const 3))
                          (i64.shr_u (local.get $acc) (i64.const 1)))
                 (i64.mul (local.get $i) (local.get $b)))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br_if $l (i64.lt_u (local.get $i) (i64.const 6))))
    (local.get $acc))

  (func (export "early") (param $n i32) (param $stop i32) (result i32)
    (local $i i32) (local $acc i32)
    (local.set $acc (i32.const 1))
    (i32.add
      (block $done (result i32)
        (loop $l
          (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 5))
                                   (i32.xor (local.get $i) (i32.const 3))))
          (if (i32.eq (local.get $i) (local.get $stop))
            (then (return (i32.sub (local.get $acc) (i32.const 1000)))))
          (if (i32.eq (local.get $i) (i32.const 9))
            (then (br $done (i32.mul (local.get $acc) (i32.const 3)))))
          (drop (br_if $done (i32.xor (local.get $acc) (local.get $i))
                             (i32.eq (local.get $i) (i32.const 6))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
        (i32.const 77))
      (local.get $i)))

  (func (export "trapmid") (param $n i32) (param $bad i32) (result i32)
    (local $i i32) (local $acc i32)
    (local.set $acc (i32.const 5))
    (loop $l
      (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 7))
        (block (result i32)
          (if (i32.eq (i32.and (local.get $i) (i32.const 3)) (i32.const 1))
            (then (if (i32.eq (local.get $i) (local.get $bad))
                    (then unreachable))))
          (i32.add (local.get $i) (i32.const 3)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $acc))

  (func (export "nested") (param $n i32) (param $m i32) (result i32)
    (local $i i32) (local $j i32) (local $s i32)
    i32.const 17
    loop $outer (param i32) (result i32)
      (local.set $j (i32.const 0))
      loop $inner (param i32) (result i32)
        i32.const 3 i32.mul local.get $j i32.add
        local.get $s local.get $j i32.xor local.get $i i32.add local.set $s
        local.get $j i32.const 1 i32.add local.tee $j
        local.get $m i32.lt_u br_if $inner
      end
      local.get $i i32.const 1 i32.add local.tee $i
      local.get $n i32.lt_u br_if $outer
    end
    local.get $s i32.add)

  (func (export "pre") (param $n i32) (result i32)
    (local $i i32) (local $acc i32)
    (local.set $acc (i32.const 1))
    (i32.add (i32.mul (local.get $n) (i32.const 13))
      (block $b (result i32)
        (loop $l
          (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 3))
                                   (local.get $i)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
        (local.get $acc))))

  (func (export "twoback") (param $n i32) (result i32)
    (local $i i32) (local $acc i32)
    (local.set $acc (i32.const 1))
    (block $out
      (loop $l
        (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 9))
                                 (i32.rotr (local.get $i) (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $l (i32.and (i32.lt_u (local.get $i) (local.get $n))
                           (i32.eqz (i32.and (local.get $i) (i32.const 1)))))
        (br_if $out (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $acc (i32.xor (local.get $acc)
                                 (i32.shl (local.get $i) (i32.const 3))))
        (br $l)))
    (local.get $acc))

  (func (export "divloop") (param $n i32) (param $z i32) (result i32)
    (local $i i32) (local $acc i32)
    (local.set $acc (i32.const 100))
    (loop $l
      (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 3))
        (i32.div_s (i32.const 1000) (i32.sub (local.get $i) (local.get $z)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $acc))

  (func $rec3 (export "rec3") (param $n i64) (result i64)
    (block $out (result i64)
      (if (i64.lt_u (local.get $n) (i64.const 2))
        (then (br $out (i64.add (local.get $n) (i64.const 12884901893)))))
      (if (i64.eq (i64.and (local.get $n) (i64.const 3)) (i64.const 2))
        (then (br $out (i64.xor (local.get $n) (i64.const 8589934593)))))
      (i64.sub (call $rec3 (i64.sub (local.get $n) (i64.const 1)))
               (i64.mul (call $rec3 (i64.sub (local.get $n) (i64.const 2)))
                        (i64.const 3)))))

  (func $leafsel (export "leafsel") (param $a i64) (param $b i64) (result i64)
    (select (i64.mul (local.get $a) (i64.const 4294967303))
            (i64.add (local.get $b) (i64.const 8589934601))
            (i64.lt_u (local.get $a) (local.get $b))))
  (func $leafid (export "leafid") (param $a i64) (param $b i64) (result i64)
    (local.get $b))
  (func $leafconst (export "leafconst") (param $a i64) (result i64)
    (i64.const 4886718345))
  (func $leafeqz (export "leafeqz") (param $a i64) (result i32)
    (i64.eqz (local.get $a)))

  (func (export "leafdrive") (param $k i64) (result i64)
    (local $i i64) (local $acc i64)
    (loop $l
      (local.set $acc (i64.add (i64.add (i64.add (local.get $acc)
        (i64.xor (call $leafsel (local.get $i) (i64.sub (local.get $k) (local.get $i)))
                 (call $leafid (local.get $i) (i64.mul (local.get $i) (i64.const 3)))))
        (call $leafconst (local.get $i)))
        (i64.extend_i32_u (call $leafeqz (local.get $i)))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br_if $l (i64.lt_u (local.get $i) (local.get $k))))
    (local.get $acc))
)
(assert_return (invoke "joins" (i32.const 0)) (i32.const 55))
(assert_return (invoke "joins" (i32.const 1)) (i32.const 55))
(assert_return (invoke "joins" (i32.const 2)) (i32.const 330))
(assert_return (invoke "joins" (i32.const 3)) (i32.const 1668))
(assert_return (invoke "joins" (i32.const 7)) (i32.const 1498548))
(assert_return (invoke "joins" (i32.const 16)) (i32.const 3007932626))
(assert_return (invoke "joins" (i32.const 33)) (i32.const 3330990906))
(assert_return (invoke "pressure" (i64.const 3) (i64.const 5) (i64.const 7) (i64.const 11)) (i64.const 1080863910568919103))
(assert_return (invoke "pressure" (i64.const 2147483647) (i64.const 4294967295) (i64.const 4294967297) (i64.const 16045690984503098046)) (i64.const 17192296700378299947))
(assert_return (invoke "pressure" (i64.const 1) (i64.const 0) (i64.const 0) (i64.const 0)) (i64.const 21))
(assert_return (invoke "pressure" (i64.const 18446744073709551615) (i64.const 18446744073709551615) (i64.const 18446744073709551615) (i64.const 18446744073709551615)) (i64.const 18))
(assert_return (invoke "early" (i32.const 10) (i32.const 100)) (i32.const 132089))
(assert_return (invoke "early" (i32.const 10) (i32.const 3)) (i32.const 55))
(assert_return (invoke "early" (i32.const 4) (i32.const 100)) (i32.const 81))
(assert_return (invoke "early" (i32.const 10) (i32.const 0)) (i32.const 4294966304))
(assert_return (invoke "early" (i32.const 12) (i32.const 100)) (i32.const 132089))
(assert_return (invoke "early" (i32.const 8) (i32.const 7)) (i32.const 132089))
(assert_return (invoke "early" (i32.const 20) (i32.const 15)) (i32.const 132089))
(assert_return (invoke "trapmid" (i32.const 8) (i32.const 100)) (i32.const 31866537))
(assert_return (invoke "trapmid" (i32.const 8) (i32.const 6)) (i32.const 31866537))
(assert_return (invoke "trapmid" (i32.const 1) (i32.const 0)) (i32.const 38))
(assert_return (invoke "trapmid" (i32.const 8) (i32.const 0)) (i32.const 31866537))
(assert_return (invoke "trapmid" (i32.const 3) (i32.const 2)) (i32.const 1895))
(assert_trap (invoke "trapmid" (i32.const 8) (i32.const 5)) "unreachable")
(assert_trap (invoke "trapmid" (i32.const 8) (i32.const 1)) "unreachable")
(assert_trap (invoke "trapmid" (i32.const 3) (i32.const 1)) "unreachable")
(assert_return (invoke "nested" (i32.const 0) (i32.const 0)) (i32.const 51))
(assert_return (invoke "nested" (i32.const 1) (i32.const 1)) (i32.const 51))
(assert_return (invoke "nested" (i32.const 3) (i32.const 4)) (i32.const 9154091))
(assert_return (invoke "nested" (i32.const 5) (i32.const 2)) (i32.const 1011239))
(assert_return (invoke "nested" (i32.const 7) (i32.const 7)) (i32.const 3925036824))
(assert_return (invoke "pre" (i32.const 0)) (i32.const 3))
(assert_return (invoke "pre" (i32.const 1)) (i32.const 16))
(assert_return (invoke "pre" (i32.const 5)) (i32.const 366))
(assert_return (invoke "pre" (i32.const 19)) (i32.const 1452827071))
(assert_return (invoke "twoback" (i32.const 0)) (i32.const 9))
(assert_return (invoke "twoback" (i32.const 1)) (i32.const 9))
(assert_return (invoke "twoback" (i32.const 2)) (i32.const 2147483657))
(assert_return (invoke "twoback" (i32.const 3)) (i32.const 2147483730))
(assert_return (invoke "twoback" (i32.const 8)) (i32.const 4360845))
(assert_return (invoke "twoback" (i32.const 9)) (i32.const 39247609))
(assert_return (invoke "twoback" (i32.const 20)) (i32.const 1901003891))
(assert_return (invoke "divloop" (i32.const 5) (i32.const 100)) (i32.const 23090))
(assert_return (invoke "divloop" (i32.const 5) (i32.const -3)) (i32.const 60463))
(assert_return (invoke "divloop" (i32.const 3) (i32.const 7)) (i32.const 724))
(assert_return (invoke "divloop" (i32.const 1) (i32.const 9)) (i32.const 189))
(assert_trap (invoke "divloop" (i32.const 5) (i32.const 2)) "integer divide by zero")
(assert_trap (invoke "divloop" (i32.const 5) (i32.const 0)) "integer divide by zero")
(assert_trap (invoke "divloop" (i32.const 1) (i32.const 0)) "integer divide by zero")
(assert_return (invoke "rec3" (i64.const 0)) (i64.const 12884901893))
(assert_return (invoke "rec3" (i64.const 1)) (i64.const 12884901894))
(assert_return (invoke "rec3" (i64.const 2)) (i64.const 8589934595))
(assert_return (invoke "rec3" (i64.const 3)) (i64.const 18446744043644780529))
(assert_return (invoke "rec3" (i64.const 4)) (i64.const 18446744017874976744))
(assert_return (invoke "rec3" (i64.const 5)) (i64.const 34359738389))
(assert_return (invoke "rec3" (i64.const 6)) (i64.const 8589934599))
(assert_return (invoke "rec3" (i64.const 9)) (i64.const 163208757339))
(assert_return (invoke "rec3" (i64.const 13)) (i64.const 936302871019))
(assert_return (invoke "leafsel" (i64.const 1) (i64.const 2)) (i64.const 4294967303))
(assert_return (invoke "leafid" (i64.const 1) (i64.const 2)) (i64.const 2))
(assert_return (invoke "leafsel" (i64.const 5) (i64.const 3)) (i64.const 8589934604))
(assert_return (invoke "leafid" (i64.const 5) (i64.const 3)) (i64.const 3))
(assert_return (invoke "leafsel" (i64.const 18446744073709551615) (i64.const 0)) (i64.const 8589934601))
(assert_return (invoke "leafid" (i64.const 18446744073709551615) (i64.const 0)) (i64.const 0))
(assert_return (invoke "leafsel" (i64.const 7) (i64.const 7)) (i64.const 8589934608))
(assert_return (invoke "leafid" (i64.const 7) (i64.const 7)) (i64.const 7))
(assert_return (invoke "leafconst" (i64.const 0)) (i64.const 4886718345))
(assert_return (invoke "leafeqz" (i64.const 0)) (i32.const 1))
(assert_return (invoke "leafconst" (i64.const 1)) (i64.const 4886718345))
(assert_return (invoke "leafeqz" (i64.const 1)) (i32.const 0))
(assert_return (invoke "leafconst" (i64.const 18446744073709551615)) (i64.const 4886718345))
(assert_return (invoke "leafeqz" (i64.const 18446744073709551615)) (i32.const 0))
(assert_return (invoke "leafdrive" (i64.const 1)) (i64.const 4886718346))
(assert_return (invoke "leafdrive" (i64.const 2)) (i64.const 18363371292))
(assert_return (invoke "leafdrive" (i64.const 7)) (i64.const 85746636036))
(assert_return (invoke "leafdrive" (i64.const 40)) (i64.const 1183311214845))
